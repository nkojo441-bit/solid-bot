# BEMPSX-NOVA environment configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit .env or real API/session credentials.

# ─────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────
# Three ways to authenticate the bot as a WhatsApp device:
#
#   (a) Pair now, interactively:    npm run pair
#   (b) Short code (recommended):   SESSION_ID=BEMPSX-XXXX-XXXX + SESSION_API=...
#   (c) Long self-contained code:   SESSION_ID=BEMPSX~<gzip+base64>
#
# Short codes are fetched once from your session server (see
# servers/session-server.js) and cached to session/creds.json.
# Long codes are decoded locally — no network needed.

# Leave blank to use interactive pairing/QR.
SESSION_ID=

# URL of your session server (only required for SHORT session IDs).
# Example: https://your-session-server.example.com
SESSION_API=

# Owner WhatsApp number, international format, digits only.
# Example Ghana: 233500835166 (no +, no spaces).
OWNER_NUMBER=

# Optional: pre-supply the number to pair (skips the interactive prompt).
# Digits only, including country code. Example: 233500835166.
PAIRING_NUMBER=

# ─────────────────────────────────────────────────────────────
# SESSION SERVER (servers/session-server.js only — not read by the bot)
# ─────────────────────────────────────────────────────────────
# Only needed when running `node servers/session-server.js` yourself.
SESSION_PORT=8022
ADMIN_TOKEN=
CODE_TTL_DAYS=30
SESSION_RATE_LIMIT=60
# ─────────────────────────────────────────────────────────────
# BOT IDENTITY
# ─────────────────────────────────────────────────────────────
BOT_NAME=BempsX-Nova
BOT_OWNER=BempsX-Nova
AUTHOR=BempsX-Nova
PACKNAME=BempsX-Nova
DESCRIPTION=Multi-device WhatsApp bot
PREFIX=.

# ─────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────
# Choose one: gemini, openai, deepseek, groq, mistral, cohere, together
AI_PROVIDER=gemini

# Optional global model override. Provider-specific *_MODEL values take precedence.
AI_MODEL=

# Provider API keys — only the selected provider is required for normal AI use.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=

# Optional provider-specific model overrides:
GEMINI_MODEL=
OPENAI_MODEL=
DEEPSEEK_MODEL=
GROQ_MODEL=
MISTRAL_MODEL=
COHERE_MODEL=
TOGETHER_MODEL=

# ─────────────────────────────────────────────────────────────
# DOWNLOAD / MEDIA GATEWAY
# ─────────────────────────────────────────────────────────────
# Optional shared gateway credentials.
BOT_API_KEY=
GATEWAY_URL=

# Optional per-service helper keys (only if your deployment uses them).
INSTAGRAM_KEY=
TIKTOK_KEY=
YOUTUBE_KEY=
TWITTER_KEY=
SPOTIFY_KEY=
FACEBOOK_KEY=
APISCRIPT_KEY=

# Optional upstream YouTube key used by the standalone gateway server.
UPSTREAM_YT_KEY=

# Optional CDN and weather service.
CDN_URL=
OPENWEATHER_API_KEY=

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Leave blank for local JSON in ./data (no setup).
#
# Set ONE of these to use a real database. Install the matching
# optional dependency first (`npm i mongodb` / `npm i pg` / `npm i mysql2`):
#
#   mongodb://user:pass@host:27017/dbname
#   mongodb+srv://user:pass@cluster.mongodb.net/dbname
#   postgres://user:pass@host:5432/dbname
#   mysql://user:pass@host:3306/dbname
#
# If the driver isn't installed, the bot logs a warning and falls
# back to JSON — it will NOT crash.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# BEHAVIOUR
# ─────────────────────────────────────────────────────────────
ANTI_LINK=true
WELCOME=true
AUTO_READ=false
FORCE_WEBSOCKET=true
AI_AGENT=true

# ─────────────────────────────────────────────────────────────
# HOSTING / SERVER
# ─────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# Used by the standalone servers/gateway.js process.
GATEWAY_PORT=8021
GATEWAY_KEY=
GATEWAY_CORS_ORIGIN=
GATEWAY_RATE_LIMIT=30
ADMIN_TOKEN=

# Media/extractor tuning.
MAX_MEDIA_BYTES=52428800
YTDLP_PATH=

# Reprint the ownership banner interval in milliseconds.
REASSERT_MS=21600000

# Force bundled yt-dlp setup to replace an existing binary when set to 1.
FORCE=0

# Additional owner JIDs, comma-separated if supported by your deployment.
OWNER_LIDS=
